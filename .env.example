# Copia in .env (escluso dal repository) e inserisci i tuoi valori. Mai committare .env.

# Token personale di Fatture in Cloud (Impostazioni > Applicazioni collegate)
FIC_ACCESS_TOKEN=

# Facoltativo se il token vede una sola azienda
FIC_COMPANY_ID=

# readonly (default) | write | full
FIC_MODE=readonly

# Test di integrazione (disattivati di default)
# FIC_IT_READONLY=1
# FIC_IT_TRIAL=1
# FIC_IT_TRIAL_TOKEN=
# FIC_IT_TRIAL_COMPANY_ID=
