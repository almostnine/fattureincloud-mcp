{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.almostnine/fattureincloud-mcp",
  "title": "Fatture in Cloud MCP (non ufficiale)",
  "description": "Fatture in Cloud API v2: fatture, rate, incassi, clienti, situazione. Sola lettura di default.",
  "version": "1.2.0",
  "repository": {
    "url": "https://github.com/almostnine/fattureincloud-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/almostnine/fattureincloud-mcp",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fattureincloud-mcp-server",
      "version": "1.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FIC_ACCESS_TOKEN",
          "description": "Token personale di Fatture in Cloud",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "FIC_COMPANY_ID",
          "description": "ID azienda, se il token ne vede più di una",
          "isRequired": false,
          "format": "number"
        },
        {
          "name": "FIC_MODE",
          "description": "readonly (default), write o full",
          "isRequired": false,
          "format": "string",
          "default": "readonly"
        },
        {
          "name": "FIC_CONFIRM_METHOD",
          "description": "conferma umana delle scritture: auto (default), elicitation o dialog (macOS)",
          "isRequired": false,
          "format": "string",
          "default": "auto"
        },
        {
          "name": "FIC_ENABLE_DELETE",
          "description": "true per attivare fic_delete (default false)",
          "isRequired": false,
          "format": "boolean",
          "default": "false"
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/almostnine/fattureincloud-mcp/releases/download/v1.2.0/fattureincloud-mcp-server-1.2.0.mcpb",
      "version": "1.2.0",
      "fileSha256": "832e6843c3c5067027ea2cb0e5574409c77f094c1129b6c277dbd15118930838",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
